
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0756b9">
<title>MyPay Neutral</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;font-family:Arial,sans-serif;
 background:#f1f6ff;color:#142b4a;
}
header{
 background:linear-gradient(135deg,#0646a8,#1684ef);
 color:white;padding:22px 18px 35px;
 border-radius:0 0 28px 28px;
}
.brand{display:flex;align-items:center;gap:12px}
.logo{
 width:52px;height:52px;background:white;
 border-radius:16px;display:grid;place-items:center;
 font-size:29px;
}
.brand h2{margin:0;font-size:22px}
.brand small{color:#dceaff}
.welcome{margin-top:28px}
.welcome h2{font-size:23px;margin:0 0 8px}
.card{
 background:white;margin:18px;padding:20px;
 border-radius:20px;
 box-shadow:0 5px 20px #174a8012;
}
.balance{
 background:linear-gradient(135deg,#0756b9,#1689ed);
 color:white;
}
.balance small{opacity:.8}
.balance h1{font-size:32px;margin:12px 0}
.actions{
 display:grid;grid-template-columns:repeat(3,1fr);
 gap:12px;
}
.action{
 border:1px solid #e2ebfa;
 background:#f8fbff;border-radius:17px;
 padding:16px 5px;text-align:center;
 cursor:pointer;color:#0756b9;
 font-weight:bold;
}
.action span{font-size:27px;display:block;margin-bottom:9px}
.action:active{transform:scale(.96)}
.section-title{font-size:18px;font-weight:bold}
.transaction{
 display:flex;justify-content:space-between;
 align-items:center;padding:14px 0;
 border-bottom:1px solid #edf1f7;
}
.transaction:last-child{border:0}
.amount{font-weight:bold}
.positive{color:#07965d}
.negative{color:#dc3657}
.owl{
 text-align:center;background:#e4f1ff;
 border-radius:20px;padding:18px;
 margin-top:18px;
}
.owl .bird{font-size:65px}
.owl h3{margin:8px;color:#0756b9}
nav{
 position:fixed;bottom:0;left:0;right:0;
 display:flex;justify-content:space-around;
 background:white;padding:12px 5px;
 box-shadow:0 -3px 15px #00000010;
}
nav button{
 border:0;background:none;color:#61748f;
 font-size:12px;cursor:pointer;
}
nav button b{display:block;font-size:21px}
nav button.active{color:#0756b9}
button.primary{
 background:#0756b9;color:white;border:0;
 border-radius:12px;padding:14px;width:100%;
 font-size:16px;font-weight:bold;cursor:pointer;
}
input{
 width:100%;padding:14px;border:1px solid #d6e2f4;
 border-radius:12px;margin:10px 0;font-size:16px;
}
.page{display:none;padding-bottom:85px}
.page.active{display:block}
footer{text-align:center;color:#8291a5;font-size:11px;padding:20px}
</style>
</head>
<body>

<header>
 <div class="brand">
  <div class="logo">🦉</div>
  <div>
   <h2>MyPay Neutral</h2>
   <small>Simple • Smart • Friendly</small>
  </div>
 </div>
 <div class="welcome">
  <h2>স্বাগতম MyPay-তে!</h2>
  <p>আপনার ডিজিটাল অভিজ্ঞতা শুরু হোক।</p>
 </div>
</header>

<main>
<section id="home" class="page active">
 <div class="card balance">
  <small>আপনার ডেমো ব্যালেন্স</small>
  <h1 id="balance">৳ ২৫,০০০.০০</h1>
  <small>এটি কাল্পনিক পরীক্ষামূলক ব্যালেন্স</small>
 </div>

 <div class="card">
  <div class="section-title">আমাদের সেবাসমূহ</div>
  <br>
  <div class="actions">
   <button class="action" onclick="showPage('send')">
    <span>📤</span>সেন্ড মানি
   </button>
   <button class="action" onclick="demo('অ্যাড মানি')">
    <span>➕</span>অ্যাড মানি
   </button>
   <button class="action" onclick="demo('ক্যাশ আউট')">
    <span>💳</span>ক্যাশ আউট
   </button>
   <button class="action" onclick="demo('মোবাইল রিচার্জ')">
    <span>📱</span>রিচার্জ
   </button>
   <button class="action" onclick="demo('বিল পেমেন্ট')">
    <span>🧾</span>বিল পে
   </button>
   <button class="action" onclick="showPage('history')">
    <span>🕒</span>হিস্ট্রি
   </button>
  </div>
 </div>

 <div class="card owl">
  <div class="bird">🦉</div>
  <h3>আমি পেঁচা!</h3>
  <p>MyPay Neutral-এর বন্ধুসুলভ সহকারী।</p>
 </div>

 <div class="card">
  <div class="section-title">সাম্প্রতিক কার্যক্রম</div>
  <div id="recent">
   <p style="color:#8492a5">এখনো কোনো ডেমো লেনদেন নেই।</p>
  </div>
 </div>
</section>

<section id="send" class="page">
 <div class="card">
  <h2>📤 সেন্ড মানি ডেমো</h2>
  <p>একটি কাল্পনিক লেনদেন পরীক্ষা করো।</p>
  <input id="number" placeholder="মোবাইল নম্বর লিখুন">
  <input id="money" type="number" placeholder="টাকার পরিমাণ">
  <button class="primary" onclick="sendDemo()">ডেমো পরীক্ষা করুন</button>
  <p style="font-size:12px;color:#8291a5">
   কোনো বাস্তব টাকা পাঠানো হবে না।
  </p>
 </div>
</section>

<section id="history" class="page">
 <div class="card">
  <h2>লেনদেনের ইতিহাস</h2>
  <div id="allHistory">কোনো ডেমো লেনদেন নেই।</div>
 </div>
</section>

<section id="profile" class="page">
 <div class="card">
  <div class="owl">
   <div class="bird">🦉</div>
   <h3>MyPay Neutral</h3>
   <p>আমাদের পেঁচা, আমাদের পরিচয়।</p>
  </div>
  <h3>প্রোফাইল</h3>
  <p>অ্যাকাউন্ট: Demo User</p>
  <p>অ্যাপ: MyPay Neutral</p>
  <p>সংস্করণ: 1.0 Demo</p>
  <button class="primary" onclick="demo('সেটিংস')">সেটিংস</button>
 </div>
</section>
</main>

<nav>
 <button class="active" onclick="showPage('home',this)">
  <b>⌂</b>হোম
 </button>
 <button onclick="showPage('history',this)">
  <b>▤</b>হিস্ট্রি
 </button>
 <button onclick="showPage('send',this)">
  <b>➤</b>সেন্ড
 </button>
 <button onclick="showPage('profile',this)">
  <b>♙</b>প্রোফাইল
 </button>
</nav>

<footer>
 MyPay Neutral © 2026<br>
 Demo Application — No Real Money
</footer>

<script>
let demoBalance=25000;
let records=[];

function showPage(id,btn){
 document.querySelectorAll('.page').forEach(p=>
  p.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.querySelectorAll('nav button').forEach(b=>
  b.classList.remove('active'));
 if(btn)btn.classList.add('active');
}

function demo(name){
 alert(name+' এখন শুধু ডেমো ফিচার।');
}

function sendDemo(){
 const number=document.getElementById('number').value.trim();
 const amount=Number(document.getElementById('money').value);

 if(!/^[0-9]{11}$/.test(number)){
  alert('১১ সংখ্যার একটি পরীক্ষামূলক নম্বর লিখুন।');
  return;
 }
 if(!Number.isFinite(amount)||amount<=0||amount>demoBalance){
  alert('সঠিক ডেমো পরিমাণ লিখুন।');
  return;
 }

 demoBalance-=amount;
 records.unshift({
  name:'সেন্ড মানি ডেমো',
  number:number,
  amount:amount
 });

 document.getElementById('balance').innerText=
  '৳ '+demoBalance.toLocaleString('en-BD');

 renderHistory();
 alert('ডেমো লেনদেন সম্পন্ন হয়েছে। কোনো বাস্তব টাকা পাঠানো হয়নি।');
 document.getElementById('number').value='';
 document.getElementById('money').value='';
}

function renderHistory(){
 const html=records.map(r=>`
  <div class="transaction">
   <div>
    <b>${r.name}</b><br>
    <small>${r.number}</small>
   </div>
   <div class="amount negative">
    -৳ ${r.amount.toLocaleString('en-BD')}
   </div>
  </div>
 `).join('');

 document.getElementById('recent').innerHTML=
  html||'<p>এখনো কোনো ডেমো লেনদেন নেই।</p>';
 document.getElementById('allHistory').innerHTML=
  html||'কোনো ডেমো লেনদেন নেই।';
}
</script>
</body>
</html>
